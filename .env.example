# Create a separate Discord application/bot for Carter. Never reuse Armory tokens.
CARTER_ENABLED=false
CARTER_DISCORD_TOKEN=
CARTER_DISCORD_GUILD_ID=
# Voice is selected per process; the logs channel is persisted per Discord server
# after /carter setlogs or /carter voicechannel.
# Comma-separated Discord user IDs permitted to control Carter (required).
CARTER_ALLOWED_USER_IDS=

# Local wake-name listening; no provider connection while waiting for "Carter".
# Retained for compatibility; runtime channel selection is always required.
CARTER_AUTO_JOIN=false
CARTER_WAKE_WORD_ENABLED=true
CARTER_WAKE_WORD=Carter
# Relative to the Carter directory. Install with: .venv/bin/python setup_wakeword.py
CARTER_WAKE_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Gemini is primary. AI connects after the wake name or /carter activate.
CARTER_AI_PROVIDER=gemini
CARTER_GEMINI_API_KEY=
CARTER_GEMINI_MODEL=gemini-3.8-live
CARTER_GEMINI_TEXT_MODEL=gemini-3.8-flash
CARTER_GEMINI_VOICE=Kore

# Paid fallback is opt-in and used only for Gemini quota/rate-limit errors.
CARTER_ALLOW_OPENAI_FALLBACK=false
CARTER_OPENAI_API_KEY=
CARTER_OPENAI_MODEL=gpt-realtime-2.1
CARTER_OPENAI_VOICE=marin

# Seconds without accepted microphone activity before AI disconnects (5..300).
CARTER_SESSION_TIMEOUT=45
# Absolute AI session duration in seconds, including continuous speech (10..900).
CARTER_MAX_SESSION_SECONDS=180
# Client-side speech/VAD RMS threshold (0..32767); raise for noisy microphones.
CARTER_INPUT_RMS_THRESHOLD=300

# Optional: summarize public Warcraft Logs links posted in the explicitly selected channel.
# Requires Discord's Message Content intent and an API client from warcraftlogs.com/api/clients/.
CARTER_WARCRAFT_LOGS_ENABLED=false
CARTER_WARCRAFT_LOGS_CLIENT_ID=
CARTER_WARCRAFT_LOGS_CLIENT_SECRET=
# Refresh an active/live report for newly added or completed fights (30..600 seconds).
CARTER_WARCRAFT_LOGS_REFRESH_SECONDS=60
# Recent Discord messages inspected at startup and by the default /logs scan (1..100).
CARTER_WARCRAFT_LOGS_SCAN_MESSAGES=5
# Maximum message window an authorized /logs scan may request (1..500).
CARTER_WARCRAFT_LOGS_BACKFILL_MESSAGES=100
# Raid-night grouping uses this IANA timezone and assigns after-midnight fights
# before the cutoff hour to the preceding raid date.
CARTER_WARCRAFT_LOGS_TIMEZONE=UTC
CARTER_WARCRAFT_LOGS_RAID_DAY_CUTOFF_HOUR=6
# Temporary troubleshooting: dumps bounded selected-channel message/embed content to the terminal.
CARTER_LOG_MESSAGE_DEBUG=false
