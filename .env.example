# Create a separate Discord application/bot for Carter. Never reuse Armory tokens.
CARTER_ENABLED=false
CARTER_DISCORD_TOKEN=
CARTER_DISCORD_GUILD_ID=
CARTER_DISCORD_VOICE_CHANNEL_ID=
# Comma-separated Discord user IDs permitted to control Carter (required).
CARTER_ALLOWED_USER_IDS=

# Local wake-name listening; no provider connection while waiting for "Carter".
CARTER_AUTO_JOIN=true
CARTER_WAKE_WORD_ENABLED=true
CARTER_WAKE_WORD=Carter
# Relative to the Carter directory. Install with: .venv/bin/python setup_wakeword.py
CARTER_WAKE_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Gemini is primary. AI connects after the wake name or /carter activate.
CARTER_AI_PROVIDER=gemini
CARTER_GEMINI_API_KEY=
CARTER_GEMINI_MODEL=gemini-3.8-live
CARTER_GEMINI_VOICE=Kore

# Paid fallback is opt-in and used only for Gemini quota/rate-limit errors.
CARTER_ALLOW_OPENAI_FALLBACK=false
CARTER_OPENAI_API_KEY=
CARTER_OPENAI_MODEL=gpt-realtime-2.1
CARTER_OPENAI_VOICE=marin

# Seconds without accepted microphone activity before AI disconnects (5..300).
CARTER_SESSION_TIMEOUT=45
# Absolute AI session duration in seconds, including continuous speech (10..900).
CARTER_MAX_SESSION_SECONDS=180
# Activity timer RMS threshold (0..32767); does not filter provider audio.
CARTER_INPUT_RMS_THRESHOLD=300
