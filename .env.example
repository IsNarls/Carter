# Carter Discord and voice process configuration.
# Copy to .env only when .env does not already exist. Never commit the private file.
CARTER_ENABLED=false
CARTER_DISCORD_TOKEN=

# Optional legacy guild ID used only to clear stale guild-scoped commands after global sync.
# Carter's current slash commands are global whether this is blank or populated.
CARTER_DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to configure and control Carter.
CARTER_ALLOWED_USER_IDS=

# Saved per-guild channel selections never authorize an automatic voice connection.
CARTER_AUTO_JOIN=false

CARTER_WAKE_WORD_ENABLED=true
CARTER_WAKE_WORD=Carter
CARTER_WAKE_MODEL_PATH=models/vosk-model-small-en-us-0.15

CARTER_AI_PROVIDER=gemini
CARTER_GEMINI_API_KEY=
CARTER_GEMINI_MODEL=gemini-3.8-live
CARTER_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
CARTER_GEMINI_TEXT_THINKING_LEVEL=minimal
CARTER_GEMINI_TEXT_TIMEOUT=20
CARTER_GEMINI_VOICE=Kore

# Keep disabled unless fallback is explicitly approved and configured.
CARTER_ALLOW_OPENAI_FALLBACK=false
CARTER_OPENAI_API_KEY=
CARTER_OPENAI_MODEL=gpt-realtime-2.1
CARTER_OPENAI_VOICE=marin

CARTER_SESSION_TIMEOUT=45
CARTER_MAX_SESSION_SECONDS=180
CARTER_INPUT_RMS_THRESHOLD=300

# Carter calls the separate Warcraft Logs analysis service over loopback.
# Warcraft Logs OAuth credentials do not belong in this file.
CARTER_ANALYSIS_ENABLED=false
CARTER_ANALYSIS_API_URL=http://127.0.0.1:8765/api/v1
CARTER_ANALYSIS_TIMEOUT=15
CARTER_ANALYSIS_ALLOW_INSECURE_REMOTE=false
CARTER_ANALYSIS_LOG_CHANNEL_INGEST=true
# Carter starts, health-checks, and stops its loopback analysis child process.
CARTER_ANALYSIS_MANAGE_BACKEND=true
CARTER_ANALYSIS_STARTUP_TIMEOUT=15
CARTER_ANALYSIS_HEALTH_INTERVAL=15

# Warcraft Logs OAuth client used only by the analysis importer.
CARTER_WARCRAFT_LOGS_CLIENT_ID=
CARTER_WARCRAFT_LOGS_CLIENT_SECRET=
