              "event_id",
              "session_id",
              "attempt_id",
              "sequence",
              "encounter_id",
              "difficulty_id",
              "log_timestamp",
              "detected_at",
              "type"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "format": "uuid"
              },
              "session_id": {
