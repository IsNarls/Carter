{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carter Companion event response v1",
  "type": "object",
  "required": [
    "schema_version",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "expired",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
